<odoo>
    <data>

        <!-- FORM VIEW -->
        <record id="view_winery_weighing_form" model="ir.ui.view">
            <field name="name">winery.weighing.form</field>
            <field name="model">winery.weighing</field>
            <field name="arch" type="xml">
                <form string="Ficha de Pesada">
                    <sheet>

                        <!-- Encabezado válido -->
                        <group string="Referencia">
                            <h2>
                                <field name="name" readonly="1"/>
                            </h2>
                        </group>

                        <!-- Dos columnas -->
                        <group>
                            <group string="Información general">
                                <field name="winegrower"/>
                                <field name="winegrower_code" readonly="1"/>
                                <field name="date"/>
                            </group>

                            <group string="RESUMEN">
                                <field name="gross_weight" readonly="1"/>
                                <field name="tare_weight" readonly="1"/>
                                <field name="net_weight" readonly="1"/>
                            </group>
                        </group>

                        <!-- Pestañas -->
                        <notebook>
                            <page string="Líneas de Pesada">
                                <field name="plot_ids"
                                       widget="many2many_tags"
                                       options="{'no_create': True}"/>
                            </page>

                            <page string="Notas">
                                <field name="description"
                                       placeholder="Notas adicionales..."/>
                            </page>
                        </notebook>

                    </sheet>
                </form>
            </field>
        </record>

        <!-- TREE VIEW -->
        <record id="view_winery_weighing_tree" model="ir.ui.view">
            <field name="name">winery.weighing.tree</field>
            <field name="model">winery.weighing</field>
            <field name="arch" type="xml">
                <tree string="Listado de Pesadas">
                    <field name="name" string="Ref"/>
                    <field name="date"/>
                    <field name="winegrower"/>
                    <field name="net_weight" sum="Total Kilos"/>
                    <field name="grape_variety_id"/>
                </tree>
            </field>
        </record>

        <!-- ACTION -->
        <record id="action_winery_weighing" model="ir.actions.act_window">
            <field name="name">Pesadas</field>
            <field name="res_model">winery.weighing</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Registra la primera pesada
                </p>
            </field>
        </record>

    </data>
</odoo>
